        "name": "Latence",
        "func": "if (msg.timestamp === undefined) {\n    node.warn(\"Pas de timestamp reçu !\");\n    msg.payload = \"erreur: pas de timestamp\";\n    return msg;\n}\nmsg.latence_ms = Date.now() - msg.timestamp;\nmsg.payload = msg.latence_ms;\nreturn msg;",
