    {
        "id": "2680321e20de3306",
        "type": "function",
        "z": "402a29498d67b2f9",
        "name": "Split mesures",
        "func": "const now = Date.now();\nconst ANOMALY_THRESHOLD = 0.8;\n\nfunction checkAnomaly(val) {\n  return (typeof val === \"number\" && val >= ANOMALY_THRESHOLD);\n}\n\nconst temp = msg.payload.temp;\nconst pres = msg.payload.pres;\nconst vib = msg.payload.vib;\nconst ener = msg.payload.ener;\n\nreturn [\n  { payload: temp, timestamp: now, anomaly: checkAnomaly(temp) },\n  { payload: pres, timestamp: now, anomaly: checkAnomaly(pres) },\n  { payload: vib, timestamp: now, anomaly: checkAnomaly(vib) },\n  { payload: ener, timestamp: now, anomaly: checkAnomaly(ener) }\n];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
